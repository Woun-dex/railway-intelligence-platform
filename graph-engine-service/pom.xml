<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.rail.platform</groupId>
        <artifactId>railway-intelligence-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>graph-engine-service</artifactId>
    <name>graph-engine-service</name>
    <description>Engine 1 — embedded Hazelcast graph, deterministic delay propagation, and RAPTOR routing</description>

    <dependencies>
        <!-- Reactive web stack: matrix endpoint + viewer + actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Reactive Kafka: consume rail.raw.position, produce rail.graph.cascade -->
        <dependency>
            <groupId>io.projectreactor.kafka</groupId>
            <artifactId>reactor-kafka</artifactId>
        </dependency>

        <!-- Protobuf contracts (single source of truth): PositionEvent, CascadeEvent -->
        <dependency>
            <groupId>com.rail.platform</groupId>
            <artifactId>shared-schemas</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Confluent Protobuf (de)serializer + Schema Registry client -->
        <dependency>
            <groupId>io.confluent</groupId>
            <artifactId>kafka-protobuf-serializer</artifactId>
        </dependency>
        <!--
          Protobuf schema provider. Required at RUNTIME by both the
          KafkaProtobufSerializer (cascade producer) and KafkaProtobufDeserializer
          (position consumer): they load io.confluent...ProtobufSchemaProvider
          during configure(). Must NOT be test-scoped.
        -->
        <dependency>
            <groupId>io.confluent</groupId>
            <artifactId>kafka-protobuf-provider</artifactId>
            <version>${confluent.version}</version>
        </dependency>

        <!-- Embedded in-memory data grid: distributed topology snapshot + recovery.
             Version is managed by the Spring Boot 3.2.5 dependency BOM. -->
        <dependency>
            <groupId>com.hazelcast</groupId>
            <artifactId>hazelcast</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
